# Öffentliche Supabase-Konfiguration
PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
PUBLIC_SUPABASE_PUBLISHABLE_KEY=ausgabe-von-npm-run-supabase-status
PUBLIC_SENTRY_DSN=

# Serverzugriff (lokal: SECRET_KEY aus `npm run supabase:status`)
SUPABASE_AUTH_SECRET_KEY=
# Optional: direkte DB-Verbindung für den Migrationscheck beim Serverstart
SUPABASE_DB_URL=

# Website und Migrationen
# Produktionsdomain, beim Build und auf dem Server setzen
SITE_ORIGIN=
# 0 deaktiviert das automatische Anwenden fehlender Migrationen
MIGRATIONS_AUTO_APPLY=1

# Redaktion: npm run admin:setup
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Sicherheit und Rate Limits
# Secrets jeweils mindestens 32 Zeichen.
# PRODUKTION: Alle Secrets getrennt und einzigartig setzen! Die Fallback-Ketten
# unten greifen nur, wenn ein Secret fehlt — in Produktion sollten ALLE vier
# Token-Secrets eigene, unabhängige Werte haben, damit die Kompromittierung
# eines Secrets nicht alle Token-Typen betrifft.
EDITOR_TRUST_SECRET=
# Signiert die Abmeldelinks der Beitrags-Benachrichtigungen. Die Tokens haben
# kein Ablaufdatum; nach dem ersten Versand nicht mehr ändern, sonst werden
# alle bereits verschickten Abmeldelinks ungültig.
NOTIFICATION_UNSUBSCRIBE_SECRET=
# Eigenes Secret für Newsletter-Bestätigungs-/Abmeldelinks (empfohlen in
# Produktion); ohne Angabe wird NOTIFICATION_UNSUBSCRIBE_SECRET verwendet.
NEWSLETTER_TOKEN_SECRET=
# Eigenes Secret für den Bestätigungslink der Kontolöschung (empfohlen in
# Produktion); ohne Angabe wird NOTIFICATION_UNSUBSCRIBE_SECRET, dann
# NEWSLETTER_TOKEN_SECRET und zuletzt SUPABASE_AUTH_SECRET_KEY verwendet.
# Die Links sind 24 Stunden gültig.
ACCOUNT_DELETION_TOKEN_SECRET=
AUTH_RATE_LIMIT_DB=.data/auth-limits.sqlite

# Mailversand (serverseitig; für App-Mails und VPS-Auth-SMTP)
MAIL_SMTP_HOST=
MAIL_SMTP_PORT=465
MAIL_SMTP_USER=
MAIL_SMTP_PASSWORD=
# Alternativ: Pfad zu einer geschützten Passwortdatei; für VPS-Auth-SMTP
# denselben Speicherpfad konfigurieren.
MAIL_SMTP_PASSWORD_FILE=
MAIL_FROM=

# Lokaler Dev-Bypass für /admin (nur im astro dev-Server wirksam, nie im
# Produktions-Build): auf "development" setzen, um ohne Anmeldung in die
# Redaktion zu gelangen. Niemals in produktiven Umgebungen setzen.
# EDITOR_AUTH_BYPASS=
