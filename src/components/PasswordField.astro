---
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  label: string;
  autocomplete: 'current-password' | 'new-password';
  help?: string;
  minlength?: number;
  maxlength?: number;
}

const {
  id,
  name,
  label,
  autocomplete,
  help,
  minlength,
  maxlength = 128,
} = Astro.props;
const helpId = help ? `${id}-help` : undefined;
---

<div class="password-field">
  <label for={id}>
    <span
      >{label}<span
        class="required-marker required-marker--always"
        aria-hidden="true"></span></span
    >
  </label>
  <div class="password-control">
    <Icon name="lock" size={17} class="reader-input-icon" />
    <input
      id={id}
      type="password"
      {name}
      {autocomplete}
      aria-describedby={helpId}
      required
      {minlength}
      {maxlength}
      data-password-input
    />
    <button
      type="button"
      class="password-toggle"
      aria-label={`${label} anzeigen`}
      aria-pressed="false"
      data-password-toggle
    >
      <Icon name="eye" size={20} class="password-icon-show" />
      <Icon name="eye-off" size={20} class="password-icon-hide" />
    </button>
  </div>
  {help && <small id={helpId}>{help}</small>}
</div>

<script>
  import { wirePasswordToggles } from '../scripts/password-toggle';

  wirePasswordToggles();
</script>
