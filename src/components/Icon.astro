---
import { renderIcon } from '../lib/icons';
import type { IconName } from '../lib/icons';

export type { IconName };

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}

const { name, size = 18, class: className } = Astro.props;
---

<Fragment set:html={renderIcon(name, size, className)} />
