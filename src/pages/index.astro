---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeading from '../components/PageHeading.astro';
import EmptyState from '../components/EmptyState.astro';
import LatestArticlesCarousel from '../components/LatestArticlesCarousel.astro';
import NextMatchCard from '../components/NextMatchCard.astro';
import { categories, getArticles, type Article } from '../lib/content';

let articles: Article[] = [];
let backendAvailable = true;
try {
  articles = await getArticles({ limit: 5 });
} catch {
  backendAvailable = false;
}
---

<BaseLayout
  title="Astro Fanblog – Analysen, News und Geschichten zum FC Example"
  description="Analysen, Spielberichte, News, PK-Zusammenfassungen und Kaderblicke rund um den FC Example – ehrlich, unabhängig und ohne Vereinsbrille."
>
  <header class="page-hero page-hero--home shell">
    <div class="home-hero">
      <div class="home-hero__main">
        <PageHeading>Fußball, wie er wirklich ist.</PageHeading>
        {
          !backendAvailable ? (
            <EmptyState
              technical
              title="Beiträge sind gerade nicht erreichbar"
              message="Bitte versuche es in ein paar Minuten noch einmal."
            />
          ) : articles.length ? (
            <LatestArticlesCarousel articles={articles} />
          ) : (
            <EmptyState
              title="Hier entsteht die nächste Geschichte"
              message="Sobald neue Beiträge veröffentlicht sind, findest du sie hier."
            />
          )
        }
      </div>
      <NextMatchCard />
    </div>
  </header>

  <section class="rubrics-section">
    <div class="shell">
      <div class="section-heading section-heading--light">
        <div>
          <span class="overline">Die Rubriken</span><h2>
            Fünf Rubriken. Klarer Blick.
          </h2>
        </div>
      </div>
      <div class="rubrics-grid">
        {
          categories.map((category, index) => (
            <a
              href={`/kategorie/${category.slug}`}
              class={`rubric-card rubric-card--${category.slug}`}
            >
              <span>0{index + 1}</span>
              <h3>{category.label}</h3>
              <p>
                {
                  [
                    'Was im Spiel wirklich passiert ist — verständlich aufgedröselt.',
                    'Meldungen, die wir prüfen, bevor wir sie einordnen.',
                    'Die Kernaussagen der PK — auf den Punkt gebracht.',
                    'Was an Gerüchten dran ist — und was der Kader wirklich braucht.',
                    'Stadion, Fanszene und alles, was neben dem Platz passiert.',
                  ][index]
                }
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="squad-teaser shell">
    <div class="section-heading">
      <div>
        <span class="overline">Kader &amp; Leihen</span><h2>Wer ist im Kader?</h2>
      </div>
    </div>
    <div class="squad-board">
      <span class="board-label">Kader 26/27</span>
      <h3>Alle Profis im Überblick.<br />Dazu die aktuellen Leihen.</h3>
      <div class="board-actions">
        <a class="button" href="/kader">Zum Kader</a>
        <a class="text-link" href="/leihspieler">Leihspieler ansehen →</a>
      </div>
    </div>
  </section>
</BaseLayout>
