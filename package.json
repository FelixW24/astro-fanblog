{
  "name": "astro-fanblog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "panda:codegen": "panda codegen",
    "prepare": "panda codegen",
    "dev": "panda codegen && astro dev",
    "predev": "npm run admin:check",
    "build": "panda codegen && astro build",
    "preview": "astro preview",
    "prepreview": "npm run admin:check -- --production",
    "start": "node server.mjs",
    "prestart": "npm run admin:check -- --production && npm run check:migrations",
    "lint": "eslint .",
    "check": "panda codegen && astro check",
    "test": "vitest run && npm run test:admin-setup",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:auth": "node scripts/test-auth.mjs",
    "test:admin-setup": "node --test scripts/setup-editor.check.mjs",
    "admin:setup": "node scripts/setup-editor.mjs",
    "admin:check": "node scripts/check-editor.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "test:e2e:ui": "playwright test --ui",
    "format": "prettier --write .",
    "supabase:start": "node scripts/start-supabase.mjs",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset --network-id fanblog-local",
    "supabase:types": "supabase gen types typescript --schema public > src/lib/database.types.ts",
    "supabase:restart": "node scripts/start-supabase.mjs --restart",
    "supabase:admin": "node scripts/configure-editor.mjs",
    "supabase:db:test": "node scripts/test-database.mjs"
  },
  "dependencies": {
    "@astrojs/node": "11.1.9",
    "@fontsource-variable/inter": "5.3.0",
    "@sentry/astro": "^11.9.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "astro": "7.4.7",
    "flag-icons": "^7.5.0",
    "gsap": "^3.15.0",
    "iconoir": "^7.12.1",
    "nodemailer": "^10.3.0",
    "pg": "^8.23.1",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@eslint/js": "^10.0.1",
    "@pandacss/dev": "1.12.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "26.4.0",
    "@types/nodemailer": "^8.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-astro": "^1.7.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "supabase": "^3.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "postcss": "8.5.28",
    "browserslist": "4.28.9",
    "postcss-selector-parser": "7.1.6"
  }
}
